# Секреты (tenancy_ocid, user_ocid, fingerprint, oci_private_key_path) сюда
# НЕ идут вообще — они приходят из Vault (secret/oci-proxmox-node/api) через
# scripts/vault-apply-wrapper.sh как TF_VAR_*. Здесь только конфиг, который
# секретом не является.

region = "eu-frankfurt-1"

compartment_ocid = ""

# `oci iam availability-domain list --compartment-id <tenancy_ocid>`
availability_domain = ""

# `oci compute image list --compartment-id <compartment_ocid> --operating-system Debian --operating-system-version 12 --shape VM.Standard.A1.Flex`
# ОБЯЗАТЕЛЬНО Debian 12 (bookworm), не Ubuntu — см. cloud-init/bootstrap.sh.tpl
image_ocid = ""

instance_shape     = "VM.Standard.A1.Flex"
instance_ocpus     = 2
instance_memory_gb = 12

hostname = "oci-pve"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

ingress_ports_tcp = [22, 8006]
ingress_ports_udp = []
